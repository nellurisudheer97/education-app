# .gitignore

# Backend
backend/target/
backend/.classpath
backend/.project
backend/.settings/
backend/*.class
backend/*.jar
backend/*.war
backend/bin/
backend/.vscode/
backend/.idea/
backend/*.iml

# Frontend
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Uploads (except structure)
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
